% Shanelle G. Clarke 
% fitting thrust stand data for sysid of bprl copter


% find all data within a certain directory and load all 
% Specify the folder where your CSV files are located
folderPath = pwd + "/data/thrust_stand/"; % Use current directory or replace with specific path, e.g., 'C:\Users\YourUser\Documents\Data'

% 1. Read the CSV file
struct_data = load_data(folderPath,'csv');


% 2. Perform polynomial fit (e.g., 2nd degree polynomial)
order = 4;
p = polyfit(x, y, order);

% 3. Calculate fitted values
y_fit = polyval(p, x);

% 4. Plot the data and the fit
figure;
plot(x, y, 'o', 'DisplayName', 'Original Data');
hold on;
plot(x, y_fit, '-', 'LineWidth', 2, 'DisplayName', 'Polynomial Fit');
legend;
grid on;
title('Data Fitting');